# AUREN Content Studio — environment variables
# Copy this file to `.env` and fill in the Instagram values when you're ready to
# post for real. Without them, "Post Now" runs a safe simulation (nothing posts).
# Do NOT commit `.env` (it's gitignored).

# ---- Server ----
PORT=4321

# ---- Instagram Graph API (real posting) ----
# Get these by following INSTAGRAM_SETUP.md. When BOTH are present, the
# "Post Now" button posts to Instagram for real.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Optional: Meta app identifiers (only needed while generating/refreshing tokens)
# META_APP_ID=
# META_APP_SECRET=

# ---- Cloudflare R2 (public video hosting for posting) ----
# Instagram fetches the MP4 from a public URL. R2 uploads over HTTPS/443, so it
# works behind corporate security agents where tunnels are blocked.
# Create a bucket + API token in the Cloudflare dashboard (see INSTAGRAM_SETUP.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Jamendo (royalty-free music search) ----
# Free client_id from https://devportal.jamendo.com/ (no card). Enables the
# music search box in the editor. Tracks are baked into the MP4.
JAMENDO_CLIENT_ID=
