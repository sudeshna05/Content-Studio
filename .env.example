# AUREN Content Studio — environment variables
# Copy this file to `.env` and fill in the Instagram values when you're ready to
# post for real. Without them, "Post Now" runs a safe simulation (nothing posts).
# Do NOT commit `.env` (it's gitignored).

# ---- Server ----
PORT=4321

# ---- Instagram Graph API (real posting) ----
# Get these by following INSTAGRAM_SETUP.md. When BOTH are present, the
# "Post Now" button posts to Instagram for real.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Optional: Meta app identifiers (only needed while generating/refreshing tokens)
# META_APP_ID=
# META_APP_SECRET=
